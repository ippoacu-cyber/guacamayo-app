// Datos mensuales reales de Hoja2 (índice 0=ene)
var H2={'2024':{ing:[0,2551,5727,3586,5347,6663,4404,7708,7189,6319,8095,4354],neto:[0,-9718,-7055,-12716,-196,1579,923,3849,3448,2367,4860,1498],hip:[0,1530,1531,1532,1533,1535,1535,1536,1537,1542,1544,1545],saldo:[0,185054,184700,184391,184206,183991,183680,183435,183181,182919,182710,182437]},'2025':{ing:[3153,4150,4881,7681,7487,4230,7030,9070,4417,4632,7386,9068],neto:[193,-246,1965,4368,4154,1131,3901,6067,1454,1365,3824,5994],hip:[1546,3003,1538,1540,1543,1545,1548,1550,1594,1597,1558,1599],saldo:[182194,180403,180246,179960,179862,179765,179663,179568,179463,179358,179253,179122]},'2026':{ing:[3804,5064,12221,805,6089,5115,4256,0,0,0,0,0],neto:[710,1414,8685,-1953,2424,1943,1759,0,0,0,0,0],hip:[1563,1566,1568,1623,1573,1575,1533,1533,1533,1533,1533,1533],saldo:[179007,178885,178667,178540,178400,178257,178183,178109,178035,177961,177886,177812]}};
// Noches reales por mes (Hoja1)
var NTS_REAL={'2024':[0,12,22,14,25,31,16,27,19,12,25,14],'2025':[10,15,18,26,26,15,26,29,15,16,25,42],'2026':[14,19,46,3,22,18,17,18,3,3,14,0]};
var RES_REAL={'2024':[0,4,1,3,1,1,4,7,5,3,7,4],'2025':[3,4,3,7,6,4,5,4,3,5,7,3],'2026':[2,6,6,1,6,4,2,3,1,1,1,0]};
var MESES=['Ene','Feb','Mar','Abr','May','Jun','Jul','Ago','Sep','Oct','Nov','Dic'];
var BKGS=[
  {name:'Lei Arresga',   init:'LA',in:'17 ago',n:9, amt:2349,d:9},
  {name:'Diego Zerecero',init:'DZ',in:'26 ago',n:2, amt:660, d:18},
  {name:'Laura Neves',   init:'LN',in:'04 sep',n:3, amt:1026,d:27},
  {name:'M.G. Alcantara',init:'MA',in:'28 oct',n:3, amt:995, d:81},
  {name:'Myguail Chappel',init:'MC',in:'02 nov',n:14,amt:3607,d:86}
];

// ══ PIN ══
var pin=localStorage.getItem(K_PIN)||'1234';
var buf='', chgPin=false;

document.getElementById('kpad').addEventListener('click',function(e){
  var k=e.target.closest('[data-k]');if(!k)return;
  var v=k.getAttribute('data-k');
  if(v==='del'){buf=buf.slice(0,-1);}
  else if(v!==''&&buf.length<4){buf+=v;}
  dots();
  if(buf.length===4)setTimeout(checkPin,70);
});
function dots(){for(var i=0;i<4;i++){var d=document.getElementById('d'+i);d.classList.toggle('on',i<buf.length);d.classList.remove('err');}}
function checkPin(){
  if(chgPin){
    if(chgPin==='first'){chgPin=buf;buf='';dots();document.querySelector('.lock-hint').textContent='Repite el nuevo PIN';return;}
    if(buf===chgPin){localStorage.setItem(K_PIN,buf);pin=buf;chgPin=false;buf='';dots();resetHint();unlock();toast('PIN actualizado ✓');return;}
    errDots();chgPin=false;buf='';return;
  }
  if(buf===pin){unlock();}else{errDots();buf='';setTimeout(dots,600);}
}
function errDots(){for(var i=0;i<4;i++){var d=document.getElementById('d'+i);d.classList.remove('on');d.classList.add('err');}if(navigator.vibrate)navigator.vibrate([50,30,50]);}
function resetHint(){document.querySelector('.lock-hint').innerHTML='PIN · por defecto <strong style="color:var(--ac)">1234</strong>';}

function unlock(){
  var lk=document.getElementById('lock');lk.classList.add('out');
  setTimeout(function(){lk.style.display='none';},320);
  checkAuth();
}

// ══ OAUTH PKCE ══
function generateCodeVerifier(){
  var arr=new Uint8Array(32);crypto.getRandomValues(arr);
  return btoa(String.fromCharCode.apply(null,arr)).replace(/\+/g,'-').replace(/\//g,'_').replace(/=/g,'');
}
async function generateCodeChallenge(verifier){
  var data=new TextEncoder().encode(verifier);
  var digest=await crypto.subtle.digest('SHA-256',data);
  return btoa(String.fromCharCode.apply(null,new Uint8Array(digest))).replace(/\+/g,'-').replace(/\//g,'_').replace(/=/g,'');
}

async function msLogin(){
  var verifier=generateCodeVerifier();
  var challenge=await generateCodeChallenge(verifier);
  localStorage.setItem('cv',verifier);
  var params=new URLSearchParams({
    client_id:CLIENT_ID,
    response_type:'code',
    redirect_uri:REDIRECT,
    scope:SCOPES,
    code_challenge:challenge,
    code_challenge_method:'S256',
    prompt:'select_account'
  });
  window.location.href=AUTHORITY+'/authorize?'+params.toString();
}

async function handleCallback(){
  var params=new URLSearchParams(window.location.search);
  var code=params.get('code');
  if(!code)return false;
  // Limpiar URL sin recargar
  window.history.replaceState({},'',REDIRECT);
  var verifier=localStorage.getItem('cv');localStorage.removeItem('cv');
  showLoading('Autenticando con Microsoft…');
  try{
    var body=new URLSearchParams({
      client_id:CLIENT_ID,
      grant_type:'authorization_code',
      code:code,
      redirect_uri:REDIRECT,
      code_verifier:verifier,
      scope:SCOPES
    });
    var resp=await fetch(AUTHORITY+'/token',{method:'POST',headers:{'Content-Type':'application/x-www-form-urlencoded'},body:body.toString()});
    var data=await resp.json();
    console.log('Token response:', JSON.stringify({error:data.error,desc:data.error_description,has_token:!!data.access_token}));
    if(data.access_token){
      saveTokens(data);
      await loadExcel(data.access_token);
      return true;
    }else{
      throw new Error((data.error||'')+(data.error_description?': '+data.error_description.substring(0,120):''));
    }
  }catch(err){
    hideLoading();
    toast('Error: '+err.message);
    showAuthScreen();
    return true;
  }
}

function saveTokens(data){
  localStorage.setItem(K_TOKEN,data.access_token);
  localStorage.setItem(K_EXPIRY,Date.now()+(data.expires_in-60)*1000);
  if(data.refresh_token)localStorage.setItem(K_RFRSH,data.refresh_token);
}

async function getValidToken(){
  var expiry=parseInt(localStorage.getItem(K_EXPIRY)||'0');
  if(Date.now()<expiry)return localStorage.getItem(K_TOKEN);
  // Intentar refresh
  var refresh=localStorage.getItem(K_RFRSH);
  if(!refresh)return null;
  try{
    var body=new URLSearchParams({client_id:CLIENT_ID,grant_type:'refresh_token',refresh_token:refresh,scope:SCOPES});
    var resp=await fetch(AUTHORITY+'/token',{method:'POST',headers:{'Content-Type':'application/x-www-form-urlencoded'},body:body.toString()});
    var data=await resp.json();
    if(data.access_token){saveTokens(data);return data.access_token;}
  }catch(e){}
  return null;
}

// ══ EXCEL via GRAPH ══
async function loadExcel(token){
  showLoading('Buscando Excel en OneDrive…');
  try{
    // Acceso directo por ruta conocida: GORKA/9. INVERSIONES/Inversiones Analisis Claude.xlsx
    var FILE_PATH='GORKA/9. INVERSIONES/Inversiones Analisis Claude.xlsx';
    var FILE_ID='BC33DC3DF6E6DCB4!sff7b183e28b64b669dc5543910e228d2';
    // Intentar primero por ruta, fallback por ID
    var itemResp=await fetch(
      GRAPH+'/me/drive/root:/'+encodeURIComponent(FILE_PATH).replace(/%2F/g,'/')+'?$select=id,name',
      {headers:{Authorization:'Bearer '+token}}
    );
    var itemId, fileName;
    if(itemResp.ok){
      var item=await itemResp.json();
      itemId=item.id; fileName=item.name;
    } else {
      // Fallback: usar ID directo
      var itemResp2=await fetch(
        GRAPH+'/me/drive/items/'+FILE_ID+'?$select=id,name',
        {headers:{Authorization:'Bearer '+token}}
      );
      if(!itemResp2.ok)throw new Error('No se pudo acceder al fichero ('+itemResp2.status+')');
      var item2=await itemResp2.json();
      itemId=item2.id; fileName=item2.name;
    }
    showLoading('Leyendo '+fileName+'…');
    // Leer hoja Airbnb (antes llamada Hoja2 en el fichero antiguo)
    // Las hojas son: Airbnb, Posicion Inversiones, Control Gastos, Coche, Inmobiliario
    var wsResp=await fetch(
      GRAPH+'/me/drive/items/'+itemId+'/workbook/worksheets',
      {headers:{Authorization:'Bearer '+token}}
    );
    if(!wsResp.ok)throw new Error('Error abriendo workbook ('+wsResp.status+')');
    var wsData=await wsResp.json();
    var hojaAirbnb=null, hojaInmob=null;
    if(wsData.value){
      hojaAirbnb=wsData.value.find(function(ws){return ws.name==='Airbnb';});
      hojaInmob=wsData.value.find(function(ws){return ws.name==='Inmobiliario';});
    }
    if(!hojaInmob)throw new Error('No se encontró la hoja Inmobiliario en el fichero');
    // Leer hoja Inmobiliario (hipoteca + ingresos mensuales)
    var wsId=encodeURIComponent(hojaInmob.id);
    var rResp=await fetch(
      GRAPH+'/me/drive/items/'+itemId+'/workbook/worksheets/'+wsId+'/usedRange?$select=values',
      {headers:{Authorization:'Bearer '+token}}
    );
    if(!rResp.ok)throw new Error('Error leyendo datos ('+rResp.status+')');
    var rData=await rResp.json();
    processExcelData(rData.values||[]);
    localStorage.removeItem(K_DEMO);
    localStorage.setItem('gn_connected','1');
    localStorage.setItem('gn_file_id',itemId);
    localStorage.setItem('gn_file_name',fileName);
    document.getElementById('cfgStatus').textContent='CONECTADO ✓';
    hideLoading();
    showApp();
    toast(fileName+' sincronizado ✓');
    updateSync(true);
  }catch(err){
    console.error('loadExcel error:',err);
    hideLoading();
    if(localStorage.getItem('gn_connected')){
      showApp();
      toast('⚠ Sin conexión · datos en caché');
      updateSync(false);
    }else{
      toast('Error: '+err.message.slice(0,80));
      setTimeout(showAuthScreen,2500);
    }
  }
}

function processExcelData(values){
  // values[i] = fila i del rango B4:Y73
  // Cols: 0=Fecha,1=Hipoteca,2=Intereses,3=Amort,4=Seguro,5=Tasas,
  //       6=CM,7=SaldoDeberia,8=SaldoDevedor,9=Otros,10=Condominio,
  //       11=Luz,12=Internet,13=Limpieza,14=Mant,15=WiseComis,16=Sumin,
  //       17=GastoMensual,18=IngresosAirbnb,19=Beneficio,20=GastoAcum,
  //       21=IngresoAcum,22=IngresoLimpio,23=IngresoLimpioAcum
  values.forEach(function(row){
    var fechaVal=row[0];
    if(!fechaVal)return;
    // La fecha viene como número serial de Excel o string
    var fecha=parseExcelDate(fechaVal);
    if(!fecha)return;
    var año=fecha.getFullYear();
    var mes=fecha.getMonth(); // 0-based
    var key=String(año);
    if(!H2[key])return;
    var ing=parseFloat(row[18])||0;
    var neto=parseFloat(row[19])||0;
    var hip=parseFloat(row[1])||0;
    var saldo=parseFloat(row[8])||0;
    H2[key].ing[mes]=Math.round(ing);
    H2[key].neto[mes]=Math.round(neto);
    H2[key].hip[mes]=Math.round(hip);
    H2[key].saldo[mes]=Math.round(saldo);
  });
  console.log('Excel procesado OK');
}

function parseExcelDate(val){
  if(val instanceof Date)return val;
  if(typeof val==='number'&&val>40000){
    // Número serial Excel → JS Date
    var d=new Date((val-25569)*86400*1000);
    return d;
  }
  if(typeof val==='string'&&val.length>=7){
    var d=new Date(val);
    if(!isNaN(d))return d;
  }
  return null;
}

// ══ FLUJO PRINCIPAL ══
async function checkAuth(){
  // ¿Venimos de un callback OAuth?
  if(window.location.search.includes('code=')){
    await handleCallback();
    return;
  }
  // ¿Modo demo?
  if(localStorage.getItem(K_DEMO)){
    document.getElementById('cfgStatus').textContent='DEMO';
    showApp();
    return;
  }
  // ¿Tenemos token válido?
  var token=await getValidToken();
  if(token){
    await loadExcel(token);
  }else{
    showAuthScreen();
  }
}

function showAuthScreen(){
  document.getElementById('authScreen').classList.add('on');
}
function showLoading(msg){
  document.getElementById('loadMsg').textContent=msg||'Cargando…';
  document.getElementById('loadingScreen').classList.add('on');
  document.getElementById('authScreen').classList.remove('on');
}
function hideLoading(){
  document.getElementById('loadingScreen').classList.remove('on');
}
function showApp(){
  hideLoading();
  document.getElementById('authScreen').classList.remove('on');
  var a=document.getElementById('app');a.classList.add('on');
  renderAll();
  setTimeout(function(){var h=document.getElementById('hipFill');if(h)h.style.width='4.4%';},250);
}
function useDemo(){
  localStorage.setItem(K_DEMO,'1');
  document.getElementById('cfgStatus').textContent='DEMO';
  showApp();
}

// ══ SYNC ══
async function doSync(){
  var dot=document.getElementById('sdot'),lbl=document.getElementById('slbl');
  dot.className='sdot spin2';lbl.textContent='…';
  if(localStorage.getItem(K_DEMO)){
    setTimeout(function(){dot.className='sdot';lbl.textContent='SYNC';toast('Datos de demo · sin OneDrive');updateSync(false);},1200);
    return;
  }
  var token=await getValidToken();
  if(token){
    await loadExcel(token);
    dot.className='sdot';lbl.textContent='SYNC';
    updateSync(true);
  }else{
    dot.className='sdot off';lbl.textContent='SYNC';
    toast('Sesión expirada · reconectando…');
    setTimeout(showAuthScreen,1000);
  }
}
function updateSync(ok){
  var n=new Date();
  var t=n.getHours()+':'+(n.getMinutes()<10?'0':'')+n.getMinutes();
  document.getElementById('syncTime').textContent=(ok?'SYNC ':' ')+t+' · PINHEIROS UTC-3';
  document.getElementById('sdot').className='sdot'+(ok?'':' off');
}

// ══ RENDER ══
function renderAll(){
  updateMesHero();
  renderAlerts();
  renderBkgs();
  renderOcc('2024');
  renderPrc('2024');
}

function getLastMesConDatos(){
  // Encuentra el último mes con ingresos > 0
  var años=['2026','2025','2024'];
  for(var a=0;a<años.length;a++){
    var año=años[a];
    var d=H2[año];
    for(var m=11;m>=0;m--){
      if(d.ing[m]>0)return{año:parseInt(año),mes:m,ing:d.ing[m],neto:d.neto[m],hip:d.hip[m],saldo:d.saldo[m]};
    }
  }
  return{año:2026,mes:6,ing:4256,neto:1759,hip:1533,saldo:178183};
}

function updateMesHero(){
  var d=getLastMesConDatos();
  var meses=['Enero','Febrero','Marzo','Abril','Mayo','Junio','Julio','Agosto','Septiembre','Octubre','Noviembre','Diciembre'];
  document.getElementById('mesLabel').textContent=meses[d.mes].toUpperCase()+' '+d.año;
  document.getElementById('mesIncome').textContent=fn(d.ing);
  var netoEl=document.getElementById('mesDelta');
  netoEl.textContent=(d.neto>=0?'+':'')+fn(Math.round(d.neto))+' neto';
  netoEl.className='mh-delta '+(d.neto>=0?'up':'dn');
  // Noches y ADR del mes
  var nts=NTS_REAL[String(d.año)]||NTS_REAL['2026'];
  var noches=nts[d.mes]||0;
  var res=RES_REAL[String(d.año)]||RES_REAL['2026'];
  var reservas=res[d.mes]||0;
  var adr=noches>0?Math.round(d.ing/noches):0;
  var diasMes=[31,28,31,30,31,30,31,31,30,31,30,31];
  var occ=noches>0?Math.round(noches/diasMes[d.mes]*100):0;
  document.getElementById('mesN').textContent=noches+'n';
  document.getElementById('mesOcc').textContent=occ+'%';
  document.getElementById('mesAdr').textContent='R$'+adr;
  document.getElementById('mesRes').textContent=reservas;
  // Saldo hipoteca actualizado
  document.getElementById('hipFill').style.width=((186016-d.saldo)/186016*100).toFixed(1)+'%';
}

function renderAlerts(){
  var d=getLastMesConDatos();
  var meses=['Ene','Feb','Mar','Abr','May','Jun','Jul','Ago','Sep','Oct','Nov','Dic'];
  // Calcular flujo acumulado real
  var acum=0;
  ['2024','2025','2026'].forEach(function(a){H2[a].neto.forEach(function(v){acum+=v;});});
  var alerts='';
  if(acum>0)alerts+='<div class="alert ok"><div class="al-icon">↑</div><div><div class="al-t">Flujo neto acumulado: R$'+fn(Math.round(acum))+'</div><div class="al-m">Generado desde el inicio de operaciones · feb-2024 a '+meses[d.mes]+' '+d.año+'.</div></div></div>';
  if(d.neto<0)alerts+='<div class="alert er"><div class="al-icon">!</div><div><div class="al-t">Mes negativo: -R$'+fn(Math.abs(Math.round(d.neto)))+' en '+meses[d.mes]+'</div><div class="al-m">Los ingresos no cubrieron los gastos e hipoteca este mes.</div></div></div>';
  else alerts+='<div class="alert ok"><div class="al-icon">→</div><div><div class="al-t">'+meses[d.mes]+' '+d.año+': R$'+fn(d.ing)+' ingresos · neto +R$'+fn(Math.round(d.neto))+'</div><div class="al-m">Saldo hipoteca actualizado: R$'+fn(Math.round(d.saldo))+'.</div></div></div>';
  alerts+='<div class="alert wa"><div class="al-icon">!</div><div><div class="al-t">ADR por debajo del tier del producto</div><div class="al-m">Con ★5.0 y Superhost podrías facturar R$320–350/noche (+R$10k/año).</div></div></div>';
  document.getElementById('alertsArea').innerHTML=alerts;
}
function renderBkgs(){
  var el=document.getElementById('bkList');if(!el)return;el.innerHTML='';
  BKGS.forEach(function(b){
    var col=b.d<=7?'color:var(--dn)':b.d<=30?'color:var(--wa)':'color:var(--t3)';
    el.innerHTML+='<div class="bk"><div class="bk-av">'+b.init+'</div><div class="bk-info"><div class="bk-name">'+b.name+'</div><div class="bk-meta">'+b.in+' · <span style="'+col+'">en '+b.d+' días</span></div></div><div class="bk-r"><div class="bk-amt">R$'+fn(b.amt)+'</div><div class="bk-n">'+b.n+'n</div><div class="bk-pill">Confirmada</div></div></div>';
  });
}
function renderOcc(yr){
  var g=document.getElementById('occGrid');if(!g)return;
  var nights=NTS[yr];var max=Math.max.apply(null,nights)||1;g.innerHTML='';
  nights.forEach(function(n,i){
    var pct=n>0?Math.round((n/max)*100):0;
    var c=pct>75?'var(--up)':pct>40?'var(--ac)':pct>10?'var(--bd2)':'var(--l3)';
    var tc=pct>75?'var(--up)':pct>40?'var(--ac)':n>0?'var(--t2)':'var(--t3)';
    g.innerHTML+='<div class="occ-cell"><div class="oc-month">'+MESES[i].slice(0,3).toUpperCase()+'</div><div class="oc-val" style="color:'+tc+'">'+n+'n</div><div class="oc-bar" style="background:'+c+';opacity:.7"></div></div>';
  });
  document.getElementById('occCardTitle').textContent='Noches vendidas · '+yr;
  document.getElementById('occCardBadge').textContent=OCC_AVG[yr]+'% ocupación';
}
function renderPrc(yr){
  var g=document.getElementById('prcGrid');if(!g)return;
  var prices=PRC[yr];g.innerHTML='';
  prices.forEach(function(p,i){
    var c=p>=300?'var(--up)':p>=250?'var(--ac)':p>0?'var(--t1)':'var(--t3)';
    g.innerHTML+='<div class="prc-cell"><div class="pc-month">'+MESES[i].slice(0,3).toUpperCase()+'</div><div class="pc-val" style="color:'+c+'">'+(p>0?p:'—')+'</div></div>';
  });
  document.getElementById('prcCardTitle').textContent='R$/noche anfitrión · '+yr;
  document.getElementById('prcCardBadge').textContent='Media R$'+PRC_AVG[yr];
}
function setYr(type,yr,btn){
  if(type==='occ'){renderOcc(yr);var par=document.getElementById('yrO');}
  else{renderPrc(yr);var par=document.getElementById('yrP');}
  par.querySelectorAll('.ytab').forEach(function(t){t.classList.remove('on');});btn.classList.add('on');
}

// ══ NAV ══
function goV(name){
  document.querySelectorAll('.view').forEach(function(v){v.classList.remove('on');});
  document.querySelectorAll('.btab').forEach(function(t){t.classList.remove('on');});
  document.getElementById('v-'+name).classList.add('on');
  document.getElementById('nt-'+name).classList.add('on');
  document.getElementById('scr').scrollTop=0;
}

// ══ SETTINGS ══
function doChangePin(){
  chgPin='first';buf='';dots();
  document.querySelector('.lock-hint').textContent='Introduce tu nuevo PIN de 4 dígitos';
  var lk=document.getElementById('lock');lk.style.display='flex';lk.classList.remove('out');
}
function doLogout(){
  if(confirm('¿Cambiar cuenta Microsoft? Se eliminará el token actual.')){
    localStorage.removeItem(K_TOKEN);localStorage.removeItem(K_EXPIRY);
    localStorage.removeItem(K_RFRSH);localStorage.removeItem('gn_connected');
    localStorage.removeItem(K_DEMO);
    showAuthScreen();document.getElementById('app').classList.remove('on');
  }
}
function doReset(){
  if(confirm('¿Cerrar sesión completamente?')){
    [K_TOKEN,K_EXPIRY,K_RFRSH,K_DEMO,'gn_connected'].forEach(function(k){localStorage.removeItem(k);});
    location.reload();
  }
}

// ══ UTILS ══
function fn(n){return Number(n).toLocaleString('pt-BR');}
function toast(msg){var t=document.getElementById('toast');t.textContent=msg;t.classList.add('on');setTimeout(function(){t.classList.remove('on');},2800);}
</script>
</body>
</html>
