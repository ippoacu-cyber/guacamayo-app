<!DOCTYPE html>
<html lang="es">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width,initial-scale=1.0,viewport-fit=cover">
<meta name="apple-mobile-web-app-capable" content="yes">
<meta name="apple-mobile-web-app-status-bar-style" content="black-translucent">
<meta name="apple-mobile-web-app-title" content="Guacamayo">
<meta name="theme-color" content="#0D1117">
<title>Guacamayo · Pinheiros</title>
<link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&family=IBM+Plex+Mono:wght@400;500;600&display=swap" rel="stylesheet">
<style>
*,*::before,*::after{box-sizing:border-box;margin:0;padding:0;-webkit-tap-highlight-color:transparent}
:root{
  --bg:#0D1117;--l1:#161B22;--l2:#1C2128;--l3:#21262D;--l4:#2D333B;
  --bd:#30363D;--bd2:#444C56;
  --ac:#2D7DD2;--ac2:#1A5FA3;--acdim:rgba(45,125,210,.12);
  --up:#3FB950;--dn:#E05C5C;--wa:#D29922;
  --updim:rgba(63,185,80,.1);--dndim:rgba(224,92,92,.1);--wadim:rgba(210,153,34,.1);
  --t1:#E6EDF3;--t2:#8B949E;--t3:#484F58;
  --body:'Inter',sans-serif;--mono:'IBM Plex Mono',monospace;
  --r:12px;--rs:8px;
  --st:env(safe-area-inset-top,0px);--sb:env(safe-area-inset-bottom,0px);
}
html,body{height:100%;background:var(--bg);color:var(--t1);font-family:var(--body);font-size:14px;overflow:hidden}

/* ══ LOCK ══ */
#lock{position:fixed;inset:0;z-index:200;background:var(--bg);display:flex;flex-direction:column;align-items:center;justify-content:center;padding:2rem;transition:opacity .3s,transform .3s}
#lock.out{opacity:0;transform:translateY(-12px);pointer-events:none}
.lock-logo{width:64px;height:64px;border-radius:18px;background:linear-gradient(135deg,var(--ac),var(--ac2));display:flex;align-items:center;justify-content:center;font-size:30px;margin-bottom:1.25rem;box-shadow:0 8px 32px rgba(45,125,210,.35)}
.lock-title{font-size:20px;font-weight:700;letter-spacing:-.03em}
.lock-sub{font-size:12px;color:var(--t3);margin-bottom:2.5rem;font-family:var(--mono)}
.dots{display:flex;gap:16px;margin-bottom:2.25rem}
.dot{width:12px;height:12px;border-radius:50%;border:1.5px solid var(--bd2);transition:background .12s,border-color .12s,transform .12s}
.dot.on{background:var(--ac);border-color:var(--ac);transform:scale(1.15)}
.dot.err{background:var(--dn);border-color:var(--dn);animation:wag .3s}
@keyframes wag{20%{transform:translateX(-6px)}60%{transform:translateX(6px)}100%{transform:translateX(0)}}
.kpad{display:grid;grid-template-columns:repeat(3,72px);gap:10px}
.k{width:72px;height:72px;border-radius:50%;border:1px solid var(--bd);background:var(--l2);font-size:22px;font-weight:500;color:var(--t1);cursor:pointer;display:flex;flex-direction:column;align-items:center;justify-content:center;gap:1px;transition:background .1s,transform .08s;user-select:none}
.k:active{background:var(--l3);transform:scale(.92)}
.ksub{font-size:8px;color:var(--t3);letter-spacing:.14em;text-transform:uppercase}
.k.del{background:transparent;border-color:transparent}
.lock-hint{font-size:11px;color:var(--t3);margin-top:1.5rem;text-align:center;line-height:1.6;font-family:var(--mono)}

/* ══ AUTH SCREEN ══ */
#authScreen{position:fixed;inset:0;z-index:150;background:var(--bg);display:none;flex-direction:column;align-items:center;justify-content:center;padding:2rem;text-align:center}
#authScreen.on{display:flex}
.auth-logo{width:72px;height:72px;border-radius:20px;background:linear-gradient(135deg,var(--ac),var(--ac2));display:flex;align-items:center;justify-content:center;font-size:34px;margin-bottom:1.5rem;box-shadow:0 8px 32px rgba(45,125,210,.35)}
.auth-h{font-size:22px;font-weight:700;letter-spacing:-.03em;margin-bottom:8px}
.auth-p{font-size:13px;color:var(--t2);line-height:1.65;margin-bottom:.5rem;max-width:300px}
.auth-file{font-size:11px;color:var(--t3);font-family:var(--mono);margin-bottom:2rem;padding:8px 14px;background:var(--l2);border:1px solid var(--bd);border-radius:var(--rs)}
.btn-ms{display:flex;align-items:center;justify-content:center;gap:10px;width:100%;max-width:300px;padding:14px;border-radius:var(--r);border:none;background:var(--ac);color:#fff;font-size:15px;font-weight:600;font-family:var(--body);cursor:pointer;transition:opacity .15s,transform .1s;letter-spacing:-.01em}
.btn-ms:active{opacity:.85;transform:scale(.98)}
.ms-icon{font-size:18px}
.btn-demo{width:100%;max-width:300px;padding:12px;border-radius:var(--r);border:1px solid var(--bd);background:transparent;color:var(--t2);font-size:13px;cursor:pointer;margin-top:.75rem;font-family:var(--body);transition:background .15s}
.btn-demo:active{background:var(--l2)}
.auth-note{font-size:11px;color:var(--t3);margin-top:1rem;line-height:1.5;font-family:var(--mono);max-width:280px}

/* ══ LOADING ══ */
#loadingScreen{position:fixed;inset:0;z-index:140;background:var(--bg);display:none;flex-direction:column;align-items:center;justify-content:center;gap:16px}
#loadingScreen.on{display:flex}
.spin{width:36px;height:36px;border-radius:50%;border:3px solid var(--bd);border-top-color:var(--ac);animation:rot 1s linear infinite}
@keyframes rot{to{transform:rotate(360deg)}}
.load-msg{font-size:12px;color:var(--t3);font-family:var(--mono)}

/* ══ APP ══ */
#app{position:fixed;inset:0;display:flex;flex-direction:column;padding-top:var(--st);padding-bottom:var(--sb);opacity:0;pointer-events:none;transition:opacity .3s}
#app.on{opacity:1;pointer-events:all}
.hdr{flex-shrink:0;display:flex;align-items:center;justify-content:space-between;padding:13px 18px 11px;border-bottom:1px solid var(--bd);background:var(--bg)}
.hdr-l{display:flex;align-items:center;gap:10px}
.hdr-logo{width:32px;height:32px;border-radius:9px;background:linear-gradient(135deg,var(--ac),var(--ac2));display:flex;align-items:center;justify-content:center;font-size:16px}
.hdr-name{font-size:14px;font-weight:700;letter-spacing:-.02em}
.hdr-sub{font-size:10px;color:var(--t3);font-family:var(--mono);margin-top:1px}
.sync-btn{display:flex;align-items:center;gap:5px;padding:5px 12px;border-radius:20px;border:1px solid var(--bd);background:var(--l1);font-size:11px;color:var(--t2);cursor:pointer;font-family:var(--mono);transition:background .15s}
.sync-btn:active{background:var(--l2)}
.sdot{width:6px;height:6px;border-radius:50%;background:var(--up);flex-shrink:0;animation:pulse 2.5s infinite}
@keyframes pulse{0%,100%{opacity:1}50%{opacity:.2}}
.sdot.spin2{background:var(--wa);animation:rot 1s linear infinite}
.sdot.off{background:var(--dn);animation:none}
.scroll{flex:1;overflow-y:auto;padding:14px 14px 10px;-webkit-overflow-scrolling:touch}
.scroll::-webkit-scrollbar{display:none}
.bnav{flex-shrink:0;display:flex;background:var(--l1);border-top:1px solid var(--bd);padding:7px 0 calc(var(--sb) + 4px)}
.btab{flex:1;display:flex;flex-direction:column;align-items:center;gap:3px;padding:5px 2px;cursor:pointer;color:var(--t3);transition:color .15s}
.btab.on{color:var(--ac)}
.bico{font-size:18px;line-height:1}
.blbl{font-size:9px;font-family:var(--mono);letter-spacing:.04em;text-transform:uppercase;font-weight:500}
.view{display:none}.view.on{display:block}
.sh{display:flex;align-items:center;gap:8px;font-size:10px;font-family:var(--mono);letter-spacing:.1em;text-transform:uppercase;color:var(--t3);margin:18px 0 8px}
.sh-line{flex:1;height:1px;background:var(--bd)}
.mhero{background:var(--l1);border:1px solid var(--bd);border-radius:var(--r);padding:18px 18px 15px;margin-bottom:10px;position:relative;overflow:hidden}
.mhero::after{content:'';position:absolute;top:0;left:0;width:100%;height:2px;background:linear-gradient(90deg,var(--ac) 0%,rgba(45,125,210,0) 100%)}
.mh-eye{font-size:10px;font-family:var(--mono);letter-spacing:.1em;text-transform:uppercase;color:var(--t3);margin-bottom:8px}
.mh-main{display:flex;align-items:baseline;gap:4px}
.mh-cur{font-size:14px;color:var(--t3);font-family:var(--mono);font-weight:500}
.mh-val{font-size:36px;font-weight:700;font-family:var(--mono);letter-spacing:-.04em;line-height:1;color:var(--t1)}
.mh-delta{font-size:13px;font-weight:600;font-family:var(--mono);margin-left:6px}
.mh-delta.up{color:var(--up)}.mh-delta.dn{color:var(--dn)}.mh-delta.wa{color:var(--wa)}
.mh-row{display:flex;margin-top:14px;padding-top:13px;border-top:1px solid var(--bd);gap:0}
.mh-stat{flex:1;display:flex;flex-direction:column;gap:3px;padding:0 8px}
.mh-stat:first-child{padding-left:0}
.mh-stat+.mh-stat{border-left:1px solid var(--bd)}
.ms-val{font-size:15px;font-weight:600;font-family:var(--mono);line-height:1;color:var(--t1)}
.ms-lbl{font-size:9px;color:var(--t3);text-transform:uppercase;letter-spacing:.07em;margin-top:2px;font-family:var(--mono)}
.dg2{display:grid;grid-template-columns:1fr 1fr;gap:8px;margin-bottom:10px}
.dg3{display:grid;grid-template-columns:1fr 1fr 1fr;gap:6px;margin-bottom:10px}
.dc{background:var(--l1);border:1px solid var(--bd);border-radius:var(--r);padding:13px 12px 11px}
.dc-lbl{font-size:9px;color:var(--t3);font-family:var(--mono);letter-spacing:.08em;text-transform:uppercase;margin-bottom:6px}
.dc-val{font-size:21px;font-weight:600;font-family:var(--mono);line-height:1;color:var(--t1)}
.dc-val.up{color:var(--up)}.dc-val.dn{color:var(--dn)}.dc-val.wa{color:var(--wa)}.dc-val.ac{color:var(--ac)}
.dc-sub{font-size:10px;color:var(--t3);margin-top:5px}
.dc-badge{font-size:10px;font-weight:600;font-family:var(--mono);float:right;margin-top:-18px}
.dc-badge.up{color:var(--up)}.dc-badge.dn{color:var(--dn)}
.card{background:var(--l1);border:1px solid var(--bd);border-radius:var(--r);margin-bottom:10px;overflow:hidden}
.card-h{display:flex;justify-content:space-between;align-items:center;padding:11px 14px;border-bottom:1px solid var(--bd)}
.ch-title{font-size:12px;font-weight:600;color:var(--t1)}
.ch-badge{font-size:10px;font-family:var(--mono);color:var(--t3)}
.dr{display:flex;justify-content:space-between;align-items:center;padding:10px 14px;border-bottom:1px solid var(--bd)}
.dr:last-child{border-bottom:none}
.dr-l{font-size:12px;color:var(--t2)}
.dr-r{font-size:12px;font-family:var(--mono);font-weight:600;color:var(--t1)}
.dr-r.up{color:var(--up)}.dr-r.dn{color:var(--dn)}.dr-r.wa{color:var(--wa)}.dr-r.ac{color:var(--ac)}
.dr.hl{background:rgba(45,125,210,.06)}
.alert{border-radius:var(--rs);padding:11px 13px;margin-bottom:8px;display:flex;gap:10px;border-width:1px;border-style:solid}
.alert.ok{background:var(--updim);border-color:rgba(63,185,80,.25)}
.alert.wa{background:var(--wadim);border-color:rgba(210,153,34,.25)}
.alert.er{background:var(--dndim);border-color:rgba(224,92,92,.25)}
.al-icon{font-size:14px;flex-shrink:0;margin-top:2px}
.al-t{font-size:12px;font-weight:600;margin-bottom:2px;line-height:1.3}
.al-m{font-size:11px;color:var(--t2);line-height:1.4}
.bk{display:flex;align-items:center;gap:11px;padding:11px 14px;border-bottom:1px solid var(--bd)}
.bk:last-child{border-bottom:none}
.bk-av{width:36px;height:36px;flex-shrink:0;border-radius:10px;background:var(--l3);display:flex;align-items:center;justify-content:center;font-size:13px;font-weight:700;font-family:var(--mono);color:var(--t2)}
.bk-info{flex:1;min-width:0}
.bk-name{font-size:13px;font-weight:500;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;color:var(--t1)}
.bk-meta{font-size:10px;color:var(--t3);margin-top:2px;font-family:var(--mono)}
.bk-r{text-align:right;flex-shrink:0}
.bk-amt{font-size:14px;font-weight:600;font-family:var(--mono);color:var(--t1)}
.bk-n{font-size:10px;color:var(--t3);margin-top:1px;font-family:var(--mono)}
.bk-pill{display:inline-block;margin-top:3px;font-size:9px;font-family:var(--mono);font-weight:600;padding:2px 6px;border-radius:4px;background:rgba(63,185,80,.1);color:var(--up)}
.hbar-item{padding:11px 14px;border-bottom:1px solid var(--bd)}
.hbar-item:last-child{border-bottom:none}
.hbar-header{display:flex;justify-content:space-between;align-items:baseline;margin-bottom:6px}
.hb-lbl{font-size:11px;color:var(--t2)}
.hb-val{font-size:13px;font-weight:600;font-family:var(--mono);color:var(--t1)}
.hb-val.up{color:var(--up)}.hb-val.ac{color:var(--ac)}.hb-val.wa{color:var(--wa)}.hb-val.muted{color:var(--t3)}
.hbar-track{height:5px;background:var(--l3);border-radius:3px;overflow:hidden}
.hbar-fill{height:100%;border-radius:3px;transition:width .8s cubic-bezier(.4,0,.2,1)}
.hbar-sub{font-size:10px;color:var(--t3);font-family:var(--mono);margin-top:4px}
.occ-grid{display:grid;grid-template-columns:repeat(4,1fr);gap:5px;padding:14px}
.occ-cell{border-radius:6px;padding:7px 6px 6px;text-align:center;background:var(--l2);position:relative;overflow:hidden}
.oc-month{font-size:9px;font-family:var(--mono);color:var(--t3);text-transform:uppercase;letter-spacing:.06em;margin-bottom:3px}
.oc-val{font-size:13px;font-weight:700;font-family:var(--mono);line-height:1}
.oc-bar{position:absolute;bottom:0;left:0;right:0;height:3px}
.prc-grid{display:grid;grid-template-columns:repeat(4,1fr);gap:5px;padding:14px}
.prc-cell{border-radius:6px;padding:7px 6px 6px;background:var(--l2);text-align:center}
.pc-month{font-size:9px;font-family:var(--mono);color:var(--t3);text-transform:uppercase;letter-spacing:.06em;margin-bottom:3px}
.pc-val{font-size:12px;font-weight:600;font-family:var(--mono);line-height:1;color:var(--t1)}
.cap-bar{display:flex;height:28px;border-radius:8px;overflow:hidden;margin:12px 14px 8px}
.cap-seg{display:flex;align-items:center;justify-content:center;font-size:10px;font-family:var(--mono);font-weight:600;color:#fff;letter-spacing:.03em}
.cap-legend{display:flex;gap:16px;padding:0 14px 12px;font-size:11px;font-family:var(--mono)}
.cap-dot{width:8px;height:8px;border-radius:2px;flex-shrink:0;margin-top:3px}
.hip-prog{padding:14px 14px 10px}
.hp-labels{display:flex;justify-content:space-between;font-size:10px;font-family:var(--mono);color:var(--t3);margin-bottom:6px}
.hp-track{height:8px;background:var(--l3);border-radius:4px;overflow:hidden;margin-bottom:5px}
.hp-fill{height:100%;background:linear-gradient(90deg,var(--ac2),var(--ac));border-radius:4px;transition:width .9s}
.hp-pct{font-size:10px;font-family:var(--mono);color:var(--t3);text-align:right}
.sc{background:var(--l1);border:1px solid var(--bd);border-radius:var(--r);margin-bottom:10px;overflow:hidden}
.sc-top{padding:14px 14px 12px;border-bottom:1px solid var(--bd)}
.sc-header{display:flex;align-items:center;justify-content:space-between;margin-bottom:10px}
.sc-name{font-size:13px;font-weight:700;letter-spacing:-.01em}
.sc-tag{font-size:10px;font-family:var(--mono);padding:3px 8px;border-radius:4px;border:1px solid}
.sc-tag.up{color:var(--up);border-color:rgba(63,185,80,.3);background:var(--updim)}
.sc-tag.ac{color:var(--ac);border-color:rgba(45,125,210,.3);background:var(--acdim)}
.sc-tag.dn{color:var(--dn);border-color:rgba(224,92,92,.3);background:var(--dndim)}
.sc-main{font-size:30px;font-weight:700;font-family:var(--mono);letter-spacing:-.04em;line-height:1}
.sc-sub{font-size:10px;color:var(--t3);font-family:var(--mono);margin-top:4px}
.sc-stats{display:flex;gap:0;margin-top:12px;padding-top:11px;border-top:1px solid var(--bd)}
.sc-stat{flex:1;padding:0 8px}
.sc-stat:first-child{padding-left:0}
.sc-stat+.sc-stat{border-left:1px solid var(--bd)}
.ss-v{font-size:13px;font-weight:600;font-family:var(--mono);line-height:1}
.ss-l{font-size:9px;color:var(--t3);margin-top:3px;text-transform:uppercase;letter-spacing:.06em;font-family:var(--mono)}
.lbtn{display:flex;align-items:center;justify-content:space-between;background:var(--l1);border:1px solid var(--bd);border-radius:var(--r);padding:13px 15px;margin-bottom:10px;cursor:pointer;text-decoration:none;color:var(--t1);transition:background .15s}
.lbtn:active{background:var(--l2)}
.lb-title{font-size:13px;font-weight:600}
.lb-sub{font-size:11px;color:var(--t3);margin-top:2px;font-family:var(--mono)}
.lb-arr{font-size:16px;color:var(--ac)}
.sg{background:var(--l1);border:1px solid var(--bd);border-radius:var(--r);margin-bottom:10px;overflow:hidden}
.si{display:flex;align-items:center;justify-content:space-between;padding:13px 14px;border-bottom:1px solid var(--bd);cursor:pointer;transition:background .12s}
.si:last-child{border-bottom:none}
.si:active{background:var(--l2)}
.si-l{font-size:13px;color:var(--t1)}
.si-r{font-size:11px;color:var(--t3);font-family:var(--mono)}
.si-arr{color:var(--t3);font-size:14px;font-family:var(--mono)}
.si.danger .si-l{color:var(--dn)}
.ytabs{display:flex;gap:6px;margin-bottom:10px}
.ytab{padding:6px 16px;border-radius:20px;border:1px solid var(--bd);background:transparent;font-size:11px;font-family:var(--mono);color:var(--t3);cursor:pointer;transition:all .15s}
.ytab.on{background:var(--ac);color:#fff;border-color:var(--ac);font-weight:600}
.toast{position:fixed;bottom:calc(var(--sb) + 80px);left:50%;transform:translateX(-50%) translateY(10px);background:var(--l3);border:1px solid var(--bd2);border-radius:20px;padding:8px 18px;font-size:11px;font-family:var(--mono);white-space:nowrap;opacity:0;transition:opacity .2s,transform .2s;z-index:500;color:var(--t1)}
.toast.on{opacity:1;transform:translateX(-50%) translateY(0)}
</style>
</head>
<body>

<!-- ══ LOCK ══ -->
<div id="lock">
  <div class="lock-logo">🦜</div>
  <div class="lock-title">Guacamayo Nido</div>
  <div class="lock-sub">PINHEIROS · SÃO PAULO · BR</div>
  <div class="dots">
    <div class="dot" id="d0"></div><div class="dot" id="d1"></div>
    <div class="dot" id="d2"></div><div class="dot" id="d3"></div>
  </div>
  <div class="kpad" id="kpad">
    <button class="k" data-k="1">1<span class="ksub"></span></button>
    <button class="k" data-k="2">2<span class="ksub">ABC</span></button>
    <button class="k" data-k="3">3<span class="ksub">DEF</span></button>
    <button class="k" data-k="4">4<span class="ksub">GHI</span></button>
    <button class="k" data-k="5">5<span class="ksub">JKL</span></button>
    <button class="k" data-k="6">6<span class="ksub">MNO</span></button>
    <button class="k" data-k="7">7<span class="ksub">PQRS</span></button>
    <button class="k" data-k="8">8<span class="ksub">TUV</span></button>
    <button class="k" data-k="9">9<span class="ksub">WXYZ</span></button>
    <button class="k" data-k="" style="visibility:hidden"></button>
    <button class="k" data-k="0">0</button>
    <button class="k del" data-k="del">⌫</button>
  </div>
  <div class="lock-hint">PIN · por defecto <strong style="color:var(--ac)">1234</strong></div>
</div>

<!-- ══ AUTH SCREEN ══ -->
<div id="authScreen">
  <div class="auth-logo">🦜</div>
  <h1 class="auth-h">Conectar con OneDrive</h1>
  <p class="auth-p">Inicia sesión con tu cuenta Microsoft para leer tu Excel automáticamente.</p>
  <div class="auth-file">📊 Inversiones Analisis Claude.xlsx</div>
  <button class="btn-ms" onclick="msLogin()">
    <span class="ms-icon">⊞</span> Continuar con Microsoft
  </button>
  <button class="btn-demo" onclick="useDemo()">Usar datos de ejemplo</button>
  <p class="auth-note">Solo se pedirá una vez. El token se guarda en el dispositivo.</p>
</div>

<!-- ══ LOADING ══ -->
<div id="loadingScreen">
  <div class="spin"></div>
  <div class="load-msg" id="loadMsg">Leyendo Excel desde OneDrive…</div>
</div>

<!-- ══ APP ══ -->
<div id="app">
  <div class="hdr">
    <div class="hdr-l">
      <div class="hdr-logo">🦜</div>
      <div>
